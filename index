<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Control Parqueadero</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#78350f">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="icon-192.png">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background-color: #78350f; }
    iframe { width: 100%; height: 100%; border: none; display: block; }
  </style>
</head>
<body>
  <!-- REEMPLAZA ESTA URL CON TU ENLACE DESPLEGADO DE GOOGLE APPS SCRIPT -->
  <iframe src="https://script.google.com/macros/s/TU_SCRIPT_ID/exec"></iframe>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js')
        .then(() => console.log('Service Worker Registrado'))
        .catch(err => console.error('Error SW:', err));
    }
  </script>
</body>
</html>
